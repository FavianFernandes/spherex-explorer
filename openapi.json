{"openapi":"3.1.0","info":{"title":"SPHEREx Explorer API","description":"Backend API connecting NASA/IPAC IRSA SPHEREx DR1/QR3, ESA Gaia DR3, NASA WISE/WiseView, and CSA NEOSSat (CADC).","version":"1.2.0"},"paths":{"/api/health":{"get":{"summary":"Health","operationId":"health_api_health_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/targets":{"get":{"summary":"Get Preset Targets","description":"Return the 5 NASA-specified test targets with verified coordinates.","operationId":"get_preset_targets_api_targets_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/search":{"post":{"summary":"Search Spherex","description":"Search NASA/IPAC IRSA for SPHEREx observations covering (RA, Dec),\ngrouped by ~6-month survey epochs for the frontend timeline slider.","operationId":"search_spherex_api_search_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SearchRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/preview":{"get":{"summary":"Get Preview Png","description":"Download/cache the SPHEREx FITS cutout and return a fresh 1:1 pixel-accurate PNG.","operationId":"get_preview_png_api_preview_get","parameters":[{"name":"cutout_url","in":"query","required":true,"schema":{"type":"string","title":"Cutout Url"}},{"name":"ra","in":"query","required":true,"schema":{"type":"number","title":"Ra"}},{"name":"dec","in":"query","required":true,"schema":{"type":"number","title":"Dec"}},{"name":"cmap","in":"query","required":false,"schema":{"type":"string","default":"inferno","title":"Cmap"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"d